# ── App ────────────────────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=INFO
API_PREFIX=/v1
CORS_ORIGINS=http://localhost:5173
# T-110: приложение всегда отправляет allow_credentials=True, поэтому '*'
# запрещён; перечислите явные origin-ы через запятую.

# ── PostgreSQL 17 + pgvector ───────────────────────────────────────
# 127.0.0.1, а не localhost: compose публикует порты только на IPv4-loopback,
# а на Windows localhost резолвится сначала в ::1 (см. STEP-06 в отчётах).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_DB=chessannotator
POSTGRES_USER=chess
POSTGRES_PASSWORD=chess_dev_password

# ── Redis ──────────────────────────────────────────────────────────
# REDIS_PORT — хостовый порт для docker-compose (по умолчанию 6380).
# Если порт занят другим проектом, задайте свободный и поправьте REDIS_URL.
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380/0

# ── Auth (T-028: JWT) ──────────────────────────────────────────────
# Публичный API защищён JWT: POST /auth/login выдаёт access+refresh,
# защищённые эндпоинты ждут `Authorization: Bearer <access>`.
# T-110: в APP_ENV=prod/production плейсхолдеры и ключи короче 32
# символов отвергаются на старте (openssl rand -hex 32).
JWT_SECRET=dev_secret_change_me_32_chars_min_000000
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
# KI-037: refresh-токен отдаётся HttpOnly-cookie, а не в теле ответа.
# Cookie уходит только на /auth/* (Path), Secure включать за HTTPS.
AUTH_COOKIE_NAME=refresh_token
AUTH_COOKIE_SECURE=false
# lax | strict | none — SameSite для refresh-cookie.
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/auth
# Домен cookie: по умолчанию не задан (host-only текущего хоста).
# Задавайте явно только если cookie должна уходить на поддомены.
# AUTH_COOKIE_DOMAIN=example.com
# Redis-denylist отозванных refresh (POST /auth/logout).
# При недоступном Redis logout работает fail-open (warning в логах).
REFRESH_DENYLIST_ENABLED=true
# Тестовый seam для старой сюиты: работает ТОЛЬКО при APP_ENV=test.
# В dev/prod игнорируется; в проде не включать.
# TEST_AUTH_BYPASS=false

# ── Engine ─────────────────────────────────────────────────────────
# либо локальный бинарник…
STOCKFISH_PATH=/usr/bin/stockfish
# …либо UCI-over-TCP (если поднят сервис stockfish в compose)
# STOCKFISH_HOST=localhost
# STOCKFISH_PORT=5000
# Число параллельных процессов Stockfish (SLA: 40 ходов ≤ 30 с, SPEC §9)
ENGINE_POOL_SIZE=4
# Кэш результатов Stockfish по позиции (T-108): ключ включает версию движка
# и depth/multipv; TTL — 30 дней, чистка при старте приложения.
ENGINE_CACHE_ENABLED=true
ENGINE_CACHE_TTL_DAYS=30

# ── PDF-экспорт комментария (T-107) ────────────────────────────────
# Путь к TTF-шрифту с кириллицей; по умолчанию ищется Arial/DejaVuSans
# в системных каталогах (Windows/Linux/macOS). Задавайте явно, если
# системного шрифта нет или нужен другой.
# PDF_FONT_PATH=C:\Windows\Fonts\arial.ttf

# ── Rate limiting ──────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_S=60

# ── LLM ────────────────────────────────────────────────────────────
# Локальная модель: LM Studio (OpenAI-совместимый API).
# Порт 8034 — локальная настройка LM Studio на dev-машине.
LLM_PROVIDER_LOCAL=lmstudio
VLLM_BASE_URL=http://127.0.0.1:8034/v1
# T-123: адрес локального LM Studio глазами приложения. На dev-машине —
# прямой адрес; на облачном VPS — вход обратного SSH-туннеля
# (например, http://172.17.0.1:8034/v1). Пусто/не задано → VLLM_BASE_URL.
# Гайд: docs/development/DEPLOYMENT_GPU_TUNNEL.md.
LLM_LOCAL_BACKEND_URL=http://127.0.0.1:8034/v1
VLLM_MODEL=qwen/qwen3-4b-2507
# LM Studio не проверяет ключ, но OpenAI-клиенты требуют непустой.
VLLM_API_KEY=lm-studio
# Облачная модель для уровня «гроссмейстер»: DeepSeek.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
# Резервные облачные провайдеры (сейчас не маршрутизируются).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# LoRA-адаптер (T-104). Путь к каталогу, обученному scripts/train_lora.py
# (например, models/lora-club-v1), или к файлу адаптера. Если путь существует
# и это каталог с adapter_config.json (или файл), локальный клиент запрашивает
# у vLLM adapter по basename; иначе используется VLLM_MODEL. vLLM запускается
# с --lora-modules lora-club-v1=<путь>. LM Studio динамические адаптеры через
# OpenAI API не поддерживает. Инструкция:
# docs/development/reports/LORA_TRAINING.md.
LORA_ADAPTER_PATH=

# Ограничения запросов LLM.
LLM_MAX_TOKENS=1024
# Лимит ответа судьи LLM-as-judge (итерация 61): JSON с оценками обрезался
# на 1024 токенах, и eval терял партии с «в ответе судьи нет JSON-объекта».
# У судьи отдельный, более щедрый лимит; обычные комментарии не меняются.
LLM_JUDGE_MAX_TOKENS=2048
# Температура генерации: ниже — стабильнее и меньше галлюцинаций.
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
# T-123 / итерации 58–60: роутер уровня club — сначала локальный GPU, при
# недоступности (ConnectError/таймаут) fallback в DeepSeek.
# LLM_LOCAL_TIMEOUT_S — таймаут HTTP-запроса локального бэкенда (LM Studio),
# секунды. Должен покрывать генерацию 7B (10–15 с): со слишком коротким
# таймаутом живой GPU считается недоступным и каждый запрос уходит в облако.
# Хост с отказом соединения даёт мгновенный fallback; таймаут ждётся только
# при «чёрной дыре»/зависшем туннеле (потом circuit-breaker).
# LLM_ROUTER_COOLDOWN_S — cooldown circuit-breaker'а (секунды).
LLM_LOCAL_TIMEOUT_S=120
LLM_ROUTER_COOLDOWN_S=60
# T-106: язык комментариев по умолчанию (ru|en). Запрос может
# переопределить его полем language, иначе учитывается Accept-Language.
DEFAULT_LANGUAGE=ru
# Прайс для `llm.cost_usd` (доллары за 1M токенов).
# Облачные цены — иллюстративные DeepSeek; локальная LM Studio — 0.
LLM_PRICE_IN_USD_PER_1M=0.27
LLM_PRICE_OUT_USD_PER_1M=1.10
LLM_LOCAL_PRICE_IN_USD_PER_1M=0
LLM_LOCAL_PRICE_OUT_USD_PER_1M=0

# ── FinOps / token budget (T-031, T-083) ───────────────────────────
# Дневные лимиты по тарифу из users.tier (free/pro). Тариф меняет только
# Stripe webhook; заголовки X-User-Tier и старый PRO_IPS не действуют.
TOKEN_BUDGET_ENABLED=true
DAILY_TOKEN_LIMIT_FREE=50000
DAILY_TOKEN_LIMIT_PRO=500000

# ── Billing / Stripe (T-083) ───────────────────────────────────────
# Пусто — billing выключен: checkout/portal/webhook отвечают 503
# billing_not_configured, остальное приложение работает как обычно.
# Ключи — Stripe Dashboard → Developers → API keys / Webhooks.
# STRIPE_PRICE_ID — цена подписки Pro (price_..., режим subscription).
# STRIPE_WEBHOOK_SECRET — whsec_... эндпоинта /v1/billing/webhook.
# success/cancel URL строятся из APP_BASE_URL (см. ниже).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ── Embeddings / RAG ───────────────────────────────────────────────
# lmstudio — реальные 768-мерные эмбеддинги; hash — тесты/CI.
EMBEDDING_PROVIDER=lmstudio
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_DIM=768

# ── Semantic cache (T-032) ─────────────────────────────────────────
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL_DAYS=30
# Косинусное расстояние: чем меньше, тем строже semantic-hit.
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.05

# ── Admin API ──────────────────────────────────────────────────────
# X-Admin-Token для POST /v1/ingest и /admin (до JWT из T-028).
# В prod dev-плейсхолдеры запрещены (T-110); пусто = admin-API закрыт.
ADMIN_API_KEY=
# Форма /admin/login: логин/пароль. Если ADMIN_PASSWORD пуст, паролем
# принимается ADMIN_API_KEY. Секрет cookie-сессии по умолчанию JWT_SECRET.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_MIN=30

# ── Observability ──────────────────────────────────────────────────
# Retention durable-истории вызовов LLM (KI-048). Чистит
# scripts/prune_llm_calls.py (cron, см. GETTING_STARTED §9).
LLM_CALLS_RETENTION_DAYS=90
# OTEL_ENABLED=true включает спаны LLM; OTEL_EXPORTER=console|otlp.
# Для observability-стека: docker compose -f docker-compose.observability.yml
# up -d; в контейнере endpoint = http://otel-collector:4318.
OTEL_ENABLED=false
OTEL_EXPORTER=console
OTEL_SERVICE_NAME=chessannotator
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTLP-метрики (llm.calls/tokens/cost/latency) для Grafana; период экспорта, мс.
OTEL_METRICS_ENABLED=true
OTEL_METRICS_INTERVAL_MS=15000

# ── Экспорт датасета (KI-050, KI-053) ──────────────────────────────
# Каталог готовых JSONL фоновых джоб (вне web-root). Относительный путь —
# от рабочего каталога процесса (в Docker /app/data/exports).
EXPORT_DIR=data/exports
# Сколько последних джоб показывать в админке.
EXPORT_JOBS_PAGE_SIZE=20
# Имя очереди arq в Redis; API и worker должны видеть одно значение.
ARQ_QUEUE_NAME=arq:queue
# `running`-джобы старше N минут при старте API/воркера → failed (recovery).
EXPORT_JOB_STALE_MINUTES=15
# Сколько дней хранить export_jobs и готовые JSONL в EXPORT_DIR (KI-054).
# Чистит scripts/prune_export_jobs.py (cron, см. GETTING_STARTED §9.3).
EXPORT_RETENTION_DAYS=7

# ── Email / верификация (KI-041) ───────────────────────────────────
# Публичный URL приложения для ссылок в письмах: /verify-email и
# /reset-password. В dev — Vite (5173), в prod — тот же origin, что API.
APP_BASE_URL=http://localhost:5173
# mock — письмо в structlog (dev/CI); smtp — реальная отправка (T-082).
EMAIL_SENDER=mock
EMAIL_FROM=noreply@chessannotator.local
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MIN=30

# ── SMTP (T-082) ───────────────────────────────────────────────────
# Действует только при EMAIL_SENDER=smtp. Для smtp обязательны SMTP_HOST
# и SMTP_FROM: пустые значения — ошибка на старте (EmailDeliveryError),
# а не «тихая» потеря письма. SMTP_STARTTLS=true — порт 587; для неявного
# TLS (порт 465) задайте SMTP_SSL=true и SMTP_STARTTLS=false.
# Аутентификация: при пустом SMTP_USER письмо уходит без username/password.
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT=30

