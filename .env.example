# ── App ────────────────────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=INFO
API_PREFIX=/v1
CORS_ORIGINS=http://localhost:5173

# ── PostgreSQL 17 + pgvector ───────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=chessannotator
POSTGRES_USER=chess
POSTGRES_PASSWORD=chess_dev_password

# ── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0

# ── Auth ───────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_prod_min_32_chars
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# ── Engine ─────────────────────────────────────────────────────────
# либо локальный бинарник…
STOCKFISH_PATH=/usr/bin/stockfish
# …либо UCI-over-TCP (если поднят сервис stockfish в compose)
# STOCKFISH_HOST=localhost
# STOCKFISH_PORT=5000

# ── LLM ────────────────────────────────────────────────────────────
LLM_PROVIDER_LOCAL=vllm
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen3-8B
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Embeddings / RAG ───────────────────────────────────────────────
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ── Observability ──────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318