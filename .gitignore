htmlcov/

# Node
node_modules/
web/dist/
web/.vite/
web/tsconfig.tsbuildinfo
*.tsbuildinfo
pnpm-lock.yaml.bak
.tmp/

# Playwright (T-036b): артефакты E2E не коммитятся
web/test-results/
