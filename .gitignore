# Python
__pycache__/
*.py[cod]
.venv/
.venv*/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
web/dist/
web/.vite/
web/tsconfig.tsbuildinfo
*.tsbuildinfo
pnpm-lock.yaml.bak
.tmp/

# Playwright (T-036b): артефакты E2E не коммитятся
web/test-results/
web/playwright-report/
web/blob-report/

# Env
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store

# Local data
# `data/*`, а не `data/`: git не может вернуть в индекс файл, если исключён
# его родительский каталог. `!data/.gitkeep` сохраняет пустой каталог.
data/*
!data/.gitkeep

# LoRA-адаптеры и веса моделей (T-104/T-080): локальные артефакты обучения,
# не коммитятся. Явные расширения страхуют веса вне `models/`.
models/
*.safetensors
*.pt
*.bin

# Датасеты LoRA (T-080): JSONL с правками редакторов — локальные данные,
# в git не попадают. Явные шаблоны дублируют `data/*` для читаемости.
data/lora_*.jsonl
data/*.jsonl
