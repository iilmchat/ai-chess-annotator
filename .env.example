# ── App ────────────────────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=INFO
API_PREFIX=/v1
CORS_ORIGINS=http://localhost:5173

# ── PostgreSQL 17 + pgvector ───────────────────────────────────────
# 127.0.0.1, а не localhost: compose публикует порты только на IPv4-loopback,
# а на Windows localhost резолвится сначала в ::1 (см. STEP-06 в отчётах).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_DB=chessannotator
POSTGRES_USER=chess
POSTGRES_PASSWORD=chess_dev_password

# ── Redis ──────────────────────────────────────────────────────────
# REDIS_PORT — хостовый порт для docker-compose (по умолчанию 6380).
# Если порт занят другим проектом, задайте свободный и поправьте REDIS_URL.
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380/0

# ── Auth (T-028: JWT) ──────────────────────────────────────────────
# Публичный API защищён JWT: POST /auth/login выдаёт access+refresh,
# защищённые эндпоинты ждут `Authorization: Bearer <access>`.
JWT_SECRET=change_me_in_prod_min_32_chars
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
# Тестовый seam для старой сюиты: работает ТОЛЬКО при APP_ENV=test.
# В dev/prod игнорируется; в проде не включать.
# TEST_AUTH_BYPASS=false

# ── Engine ─────────────────────────────────────────────────────────
# либо локальный бинарник…
STOCKFISH_PATH=/usr/bin/stockfish
# …либо UCI-over-TCP (если поднят сервис stockfish в compose)
# STOCKFISH_HOST=localhost
# STOCKFISH_PORT=5000
# Число параллельных процессов Stockfish (SLA: 40 ходов ≤ 30 с, SPEC §9)
ENGINE_POOL_SIZE=4

# ── Rate limiting ──────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_S=60

# ── LLM ────────────────────────────────────────────────────────────
# Локальная модель: LM Studio (OpenAI-совместимый API).
# Порт 8034 — локальная настройка LM Studio на dev-машине.
LLM_PROVIDER_LOCAL=lmstudio
VLLM_BASE_URL=http://127.0.0.1:8034/v1
VLLM_MODEL=qwen/qwen3-4b-2507
# LM Studio не проверяет ключ, но OpenAI-клиенты требуют непустой.
VLLM_API_KEY=lm-studio
# Облачная модель для уровня «гроссмейстер»: DeepSeek.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
# Резервные облачные провайдеры (сейчас не маршрутизируются).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# LoRA-адаптер (T-104). Путь монтируется в vLLM; basename используется
# как имя adapter-модели при запросе. LM Studio динамические адаптеры
# через OpenAI API не поддерживает.
LORA_ADAPTER_PATH=

# Ограничения запросов LLM.
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
# Прайс для `llm.cost_usd` (доллары за 1M токенов).
# Облачные цены — иллюстративные DeepSeek; локальная LM Studio — 0.
LLM_PRICE_IN_USD_PER_1M=0.27
LLM_PRICE_OUT_USD_PER_1M=1.10
LLM_LOCAL_PRICE_IN_USD_PER_1M=0
LLM_LOCAL_PRICE_OUT_USD_PER_1M=0

# ── FinOps / token budget (T-031) ──────────────────────────────────
# Дневные лимиты токенов на IP или X-User-Id. Pro-тир — заголовок
# X-User-Tier: pro (до появления JWT/ролей это не аутентификация).
TOKEN_BUDGET_ENABLED=true
DAILY_TOKEN_LIMIT_FREE=50000
DAILY_TOKEN_LIMIT_PRO=500000

# ── Embeddings / RAG ───────────────────────────────────────────────
# lmstudio — реальные 768-мерные эмбеддинги; hash — тесты/CI.
EMBEDDING_PROVIDER=lmstudio
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_DIM=768

# ── Semantic cache (T-032) ─────────────────────────────────────────
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL_DAYS=30
# Косинусное расстояние: чем меньше, тем строже semantic-hit.
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.05

# ── Admin API ──────────────────────────────────────────────────────
# X-Admin-Token для POST /v1/ingest и /admin (до JWT из T-028).
ADMIN_API_KEY=
# Форма /admin/login: логин/пароль. Если ADMIN_PASSWORD пуст, паролем
# принимается ADMIN_API_KEY. Секрет cookie-сессии по умолчанию JWT_SECRET.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_MIN=30

# ── Observability ──────────────────────────────────────────────────
# OTEL_ENABLED=true включает спаны LLM; OTEL_EXPORTER=console|otlp.
OTEL_ENABLED=false
OTEL_EXPORTER=console
OTEL_SERVICE_NAME=chessannotator
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318